# ---------------------------------------------------------------------------
# AIO Arr configuration. Copy to .env and adjust. Everything except the admin
# account can also be configured later in the web UI (Settings).
# ---------------------------------------------------------------------------

# --- container -------------------------------------------------------------
PUID=1000
PGID=1000
TZ=Etc/UTC
AIO_PORT=8080
# docker network shared with your *arr apps (docker network ls)
ARR_NETWORK=arr
# host folder that holds your downloads + media (mounted at /data)
DATA_DIR=/data

# --- your login ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# local (default) | proxy (trust Remote-User from Authelia/Authentik) | none (no login, LAN only!)
AUTH_MODE=local
# also allow Jellyfin accounts to sign in: off | admins | all
JELLYFIN_LOGIN=off

# "seed": the values below only initialise settings once, then the UI owns them.
# "override": the values below always win and are read-only in the UI.
SETTINGS_FROM_ENV=seed

# --- subdomain (used by the Caddy / Traefik overlays) -----------------------
# AIO_DOMAIN=arr.example.com
# COMPOSE_FILE=docker-compose.yml:deploy/caddy/docker-compose.caddy.yml

# --- services (internal URL = how AIO reaches them on the docker network) ---
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
# READARR_URL=http://readarr:8787
# READARR_API_KEY=
# BAZARR_URL=http://bazarr:6767
# BAZARR_API_KEY=

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
# the address your browser uses for Jellyfin - needed for "Watch in Jellyfin"
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com

# NAVIDROME_URL=http://navidrome:4533
# NAVIDROME_USERNAME=
# NAVIDROME_PASSWORD=
# NAVIDROME_PUBLIC_URL=https://music.example.com
# AUDIOBOOKSHELF_URL=http://audiobookshelf:80
# AUDIOBOOKSHELF_API_KEY=
# AUDIOBOOKSHELF_PUBLIC_URL=https://audiobooks.example.com

# --- download clients ------------------------------------------------------
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
# SABNZBD_URL=http://sabnzbd:8080
# SABNZBD_API_KEY=
# TRANSMISSION_URL=http://transmission:9091
# DELUGE_URL=http://deluge:8112
# DELUGE_PASSWORD=deluge
# NZBGET_URL=http://nzbget:6789
# NZBGET_USERNAME=nzbget
# NZBGET_PASSWORD=

# --- folders (as seen inside the AIO container) ------------------------------
MUSIC_PATH=/data/media/music
AUDIOBOOKS_PATH=/data/media/audiobooks
# Optional: folders shown in "Files" (default: whatever your download clients use)
# DOWNLOADS_PATHS=/data/torrents,/data/usenet/complete
# Only if your download client sees files at a different path than AIO does:
# PATH_MAPPINGS=/downloads:/data/torrents
